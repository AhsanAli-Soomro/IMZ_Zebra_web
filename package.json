{
  "name": "habib-rice-corporation",
  "version": "0.1.0",
  "private": true,
  "description": "Habib Rice Corporation IMS desktop application",
  "author": "Ahsan Ali Soomro",
  "main": "electron/main.js",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-webstorage next dev -p 3001",
    "electron": "electron .",
    "dev:all": "npm run rebuild:node && concurrently \"npm run dev\" \"wait-on http://127.0.0.1:3001 && npm run electron\"",
    "build:web": "npm run rebuild:node && next build && shx mkdir -p .next/standalone/.next && shx cp -r .next/static .next/standalone/.next/ && shx cp -r public .next/standalone/",
    "build": "npm run build:web",
    "start": "next start -p 3001",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "npx @electron/rebuild -f -w better-sqlite3",
    "sync:standalone-native": "shx rm -rf .next/standalone/node_modules/better-sqlite3 && shx mkdir -p .next/standalone/node_modules && shx cp -r node_modules/better-sqlite3 .next/standalone/node_modules/",
    "dist:mac": "npm run build:web && npm run rebuild:electron && npm run sync:standalone-native && electron-builder --mac --publish never",
    "dist:win": "npm run build:web && npm run rebuild:electron && npm run sync:standalone-native && electron-builder --win --x64 --publish never",
    "dist": "npm run dist:mac",
    "lint": "next lint",
    "db:init": "node scripts/init-db.js",
    "migrate:sqlite": "node scripts/mysql-to-sqlite.js",
    "migrate": "node scripts/run-migrations.js"
  },
  "build": {
    "appId": "com.habibrice.corporation",
    "productName": "Habib Rice Corporation",
    "artifactName": "Habib-Rice-Corporation-Setup.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*",
      "database/ims.sqlite",
      "database/schema.sql",
      "scripts/**/*",
      "lib/**/*",
      "app/**/*",
      "build/icon.ico",
      "build/icon.icns",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "database",
        "to": "database",
        "filter": [
          "ims.sqlite",
          "schema.sql",
          "!*.sqlite-wal",
          "!*.sqlite-shm"
        ]
      }
    ],
    "asarUnpack": [
      ".next/standalone/**/*",
      "**/*.node",
      "scripts/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Habib Rice Corporation",
      "uninstallDisplayName": "Habib Rice Corporation",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "axios": "^1.10.0",
    "better-sqlite3": "^12.8.0",
    "chart.js": "^4.5.0",
    "cookie": "^1.0.2",
    "csv-parse": "^5.6.0",
    "dotenv": "^17.3.1",
    "html2pdf.js": "^0.10.3",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "next": "15.3.4",
    "puppeteer": "^24.10.2",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-toastify": "^11.0.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@tailwindcss/postcss": "^4",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "shx": "^0.4.0",
    "tailwindcss": "^4",
    "wait-on": "^9.0.4"
  }
}