# ============================================================
# Zebra IMS & POS System - Environment Configuration Template
# ============================================================

# ------------------------------------------------------------
# 1. Vercel License Server Environment Variables
# (Configure these in your Vercel Project Dashboard -> Settings -> Environment Variables)
# ------------------------------------------------------------
# Neon PostgreSQL Connection Pooler URL (Serverless)
NEON_DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-small-smoke-b5a3it1v-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require

# Secure License HMAC Secret (Used to sign and verify tamper-proof licenses)
APP_LICENSE_SECRET=hrc-ims-zebra-prod-secret-98234-x89f-2026

# Admin Password for Remote Admin Dashboard (/admin)
ADMIN_PASSWORD=your_secure_admin_password_here

# ------------------------------------------------------------
# 2. Desktop POS Client (Electron / Local Next.js)
# (Used when packaging or running desktop POS)
# ------------------------------------------------------------
# Points to your deployed Vercel License Server URL (NO trailing slash)
# Example: https://your-ims-license-server.vercel.app
LICENSE_SERVER_URL=https://imz-zebra-web.vercel.app
NEXT_PUBLIC_LICENSE_API_URL=https://imz-zebra-web.vercel.app

# Local App Port
PORT=3002
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Local SQLite Database Path (Optional: defaults to database/ims.sqlite)
# SQLITE_DB_PATH=database/ims.sqlite

# ------------------------------------------------------------
# 3. Optional Gemini AI Integration
# ------------------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key_here

