# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# electron-builder output
/dist/

# DO NOT ignore /build because it contains app icons:
# build/icon.ico
# build/icon.icns

# SQLite temporary files
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm
*.sqlite-journal
*.db-journal
*.sqlite3-wal
*.sqlite3-shm

# Optional local database backups
database/*backup*.sqlite
database/*backup*.db
database/*backup*
database/*.bak*
database/*.bak
*.bak
*.bak_*

# Keep production seed database and schema
!database/ims.sqlite
!database/schema.sql

# OS & system junk
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Android & Capacitor mobile build
*.apk
*.aab
admin-mobile/node_modules/
admin-mobile/android/.gradle/
admin-mobile/android/app/build/
admin-mobile/android/build/
admin-mobile/android/local.properties
admin-mobile/android/.idea/
